{% import "vars.macro.twig" as vars %}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ meta_title }}</title>
    <meta name="author" content="{{ vars.partdb_title() }}">
    <meta name="description" content="Label for {{ meta_title }}">
    <meta name="keywords" content="Part-DB, Label, Barcode">
    <style>
        {% include("label_system/labels/label_style.css.twig") %}{% if sheet %}
        {# Sheet mode: the page is the whole sheet, every label is placed absolutely at its exact position (in mm) #}
        @page { margin: 0; }
        .sheet-label { position: absolute; overflow: hidden; }
        {# Same inner spacing as the page margin of a single label, so a label looks the same in both modes #}
        .sheet-label-inner { position: absolute; top: 12px; bottom: 12px; left: 6px; right: 6px; overflow: hidden; }
        .sheet-label .C39-container { position: absolute; }
{% endif %}
        {# We must not escape it here, as the string might contain ", which would be escaped. As user can control the whole HTML, XSS is not really a problem here. #}
        {{ options.additionalCss | raw }}
    </style>
</head>
<body>
{% if sheet %}
{% for page in sheet.pages %}
    <div class="page">
        <div class="page-inner">
        {% for element in page %}
            <div class="sheet-label" style="left: {{ element.x|number_format(3, '.', '') }}mm; top: {{ element.y|number_format(3, '.', '') }}mm; width: {{ sheet.label[0]|number_format(3, '.', '') }}mm; height: {{ sheet.label[1]|number_format(3, '.', '') }}mm;">
                <div class="sheet-label-inner">
                {% if options.barcodeType.none %}
                    {% include "label_system/labels/label_page_none.html.twig" %}
                {% elseif options.barcodeType.is2D() %}
                    {% include "label_system/labels/label_page_qr.html.twig" %}
                {% elseif options.barcodeType.is1D() %}
                    {% include "label_system/labels/label_page_1d.html.twig" %}
                {% endif %}
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
{% endfor %}
{% else %}
{% for element in elements %}
    {# The page div ensures the page breaks, while the page-inner elements restrict the content to the page size. Sine dompdf 3.1.1 we cannot apply the position: absolute; to the page element directly. #}
    <div class="page">
        <div class="page-inner">
            {% if options.barcodeType.none %}
                {% include "label_system/labels/label_page_none.html.twig" %}
            {% elseif options.barcodeType.is2D() %}
                {% include "label_system/labels/label_page_qr.html.twig" %}
            {% elseif options.barcodeType.is1D() %}
                {% include "label_system/labels/label_page_1d.html.twig" %}
            {% endif %}
        </div>
    </div>
{% endfor %}
{% endif %}
</body>
</html>
